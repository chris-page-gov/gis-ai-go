{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gis-ai-go.invalid/gcp/config/v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "_status": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "enum": [
        "personal-network-private",
        "bduk-sandpit-network-private"
      ]
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "number": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_account": {
          "type": [
            "string",
            "null"
          ]
        },
        "billing_account": {
          "type": [
            "string",
            "null"
          ]
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "billing_currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "billing_currency_evidence": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "number",
        "expected_account",
        "billing_account",
        "region",
        "billing_currency",
        "billing_currency_evidence"
      ]
    },
    "authority": {
      "type": "object",
      "properties": {
        "approved_plan_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "spend_envelope": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "currency": {
                  "type": "string",
                  "minLength": 1
                },
                "maximum_initial": {
                  "type": "number",
                  "minimum": 0
                },
                "maximum_monthly": {
                  "type": "number",
                  "minimum": 0
                },
                "pilot_days": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 90
                },
                "pricing_as_of": {
                  "type": "string",
                  "minLength": 1
                },
                "pricing_source": {
                  "type": "string",
                  "minLength": 1
                },
                "assumptions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "estimated_initial": {
                  "type": "number",
                  "minimum": 0
                },
                "estimated_monthly": {
                  "type": "number",
                  "minimum": 0
                },
                "budget_is_alert_only": {
                  "const": true
                },
                "maximum_total": {
                  "type": "number",
                  "minimum": 0
                },
                "estimated_total": {
                  "type": "number",
                  "minimum": 0
                },
                "estimated_retained": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false,
              "required": [
                "currency",
                "maximum_initial",
                "maximum_monthly",
                "pilot_days",
                "pricing_as_of",
                "pricing_source",
                "assumptions",
                "estimated_initial",
                "estimated_monthly",
                "budget_is_alert_only",
                "maximum_total",
                "estimated_total",
                "estimated_retained"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "pilot_end": {
          "type": [
            "string",
            "null"
          ]
        },
        "cloud_mutations_approved": {
          "type": "boolean"
        },
        "platform_approval_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "planning_budget_total": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "planning_budget_currency": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "approved_plan_id",
        "spend_envelope",
        "pilot_end",
        "cloud_mutations_approved",
        "planning_budget_total",
        "planning_budget_currency"
      ]
    },
    "network": {
      "type": "object",
      "properties": {
        "ingress": {
          "const": "internal"
        },
        "access_mode": {
          "enum": [
            "iap-ssh-to-private-vpc",
            "platform-approved-private-network"
          ]
        },
        "public_app_endpoint": {
          "const": false
        },
        "vm_external_ip": {
          "const": false
        },
        "vpc_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "subnet_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "private_google_access": {
          "const": true
        },
        "runtime_provider_egress": {
          "const": false
        },
        "shared_vpc_host_project": {
          "type": [
            "string",
            "null"
          ]
        },
        "create_access_vm": {
          "type": "boolean"
        },
        "subnet_cidr": {
          "type": "string",
          "minLength": 1
        },
        "access_vm_image": {
          "type": [
            "string",
            "null"
          ]
        },
        "access_vm_zone": {
          "type": [
            "string",
            "null"
          ]
        },
        "access_vm_machine_type": {
          "type": "string",
          "minLength": 1
        },
        "access_principals": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:(?:user|group|serviceAccount):[^\\s@]+@[^\\s@]+|principal(?:Set)?://iam\\.googleapis\\.com/[^\\s*]+)$"
          }
        },
        "transport_principals": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:(?:user|group|serviceAccount):[^\\s@]+@[^\\s@]+|principal(?:Set)?://iam\\.googleapis\\.com/[^\\s*]+)$"
          }
        },
        "access_vm_on_demand": {
          "type": "boolean"
        },
        "access_vm_max_connected_hours": {
          "type": "number",
          "minimum": 1,
          "maximum": 80
        }
      },
      "additionalProperties": false,
      "required": [
        "ingress",
        "access_mode",
        "public_app_endpoint",
        "vm_external_ip",
        "vpc_id",
        "subnet_id",
        "private_google_access",
        "runtime_provider_egress",
        "create_access_vm",
        "subnet_cidr",
        "access_vm_image",
        "access_vm_zone",
        "access_vm_machine_type",
        "access_principals",
        "transport_principals",
        "access_vm_on_demand",
        "access_vm_max_connected_hours"
      ]
    },
    "identity": {
      "type": "object",
      "properties": {
        "initial_milestone": {
          "type": [
            "string",
            "null"
          ]
        },
        "human_identity_mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "workload_principal": {
          "type": [
            "string",
            "null"
          ]
        },
        "oidc_issuer": {
          "type": [
            "string",
            "null"
          ]
        },
        "client_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "resource_audience": {
          "type": [
            "string",
            "null"
          ]
        },
        "secret_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "federation_resource": {
          "type": [
            "string",
            "null"
          ]
        },
        "claims_mapping": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "subject_roles": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "viewer",
                        "analyst",
                        "evidence-auditor",
                        "platform-operator",
                        "owner"
                      ]
                    },
                    "minItems": 1
                  },
                  "maxProperties": 16
                }
              },
              "required": [
                "subject_roles"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "group_attribute_mapping": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "claim": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_]+$"
                },
                "roles": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "viewer",
                        "analyst",
                        "evidence-auditor",
                        "platform-operator",
                        "owner"
                      ]
                    },
                    "minItems": 1
                  }
                }
              },
              "required": [
                "claim",
                "roles"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "runtime_service_account": {
          "type": [
            "string",
            "null"
          ]
        },
        "transport_service_account": {
          "type": [
            "string",
            "null"
          ]
        },
        "transport_subject": {
          "type": [
            "string",
            "null"
          ]
        },
        "jwks_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "browser": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "client_id": {
                  "type": "string",
                  "minLength": 1
                },
                "client_auth_method": {
                  "enum": [
                    "none",
                    "client_secret_basic"
                  ]
                },
                "callback_url": {
                  "type": "string",
                  "pattern": "^https://[^\\s]+$"
                },
                "allowed_redirect_uris": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^https://[^\\s]+$"
                  },
                  "minItems": 1,
                  "maxItems": 4,
                  "uniqueItems": true
                },
                "allowed_endpoints": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^https://[^\\s]+$"
                  },
                  "minItems": 3,
                  "maxItems": 8,
                  "uniqueItems": true
                },
                "scopes": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "openid",
                      "profile",
                      "email",
                      "groups"
                    ]
                  },
                  "minItems": 1,
                  "maxItems": 4,
                  "uniqueItems": true
                },
                "session_seconds": {
                  "const": 300
                },
                "session_key_secret": {
                  "type": "object",
                  "properties": {
                    "resource": {
                      "type": "string",
                      "pattern": "^projects/[a-z0-9-]+/secrets/[A-Za-z0-9_-]+$"
                    },
                    "version": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*$"
                    }
                  },
                  "required": [
                    "resource",
                    "version"
                  ],
                  "additionalProperties": false
                },
                "client_secret": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "resource": {
                          "type": "string",
                          "pattern": "^projects/[a-z0-9-]+/secrets/[A-Za-z0-9_-]+$"
                        },
                        "version": {
                          "type": "string",
                          "pattern": "^[1-9][0-9]*$"
                        }
                      },
                      "required": [
                        "resource",
                        "version"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "client_id",
                "client_auth_method",
                "callback_url",
                "allowed_redirect_uris",
                "allowed_endpoints",
                "scopes",
                "session_seconds",
                "session_key_secret",
                "client_secret"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "initial_milestone",
        "human_identity_mode",
        "workload_principal",
        "oidc_issuer",
        "client_id",
        "resource_audience",
        "secret_reference",
        "claims_mapping",
        "runtime_service_account",
        "transport_service_account",
        "transport_subject",
        "jwks_uri"
      ]
    },
    "policy": {
      "type": "object",
      "properties": {
        "default_decision": {
          "const": "deny"
        },
        "policy_release": {
          "type": [
            "string",
            "null"
          ]
        },
        "role_toolsets_manifest": {
          "type": [
            "string",
            "null"
          ]
        },
        "mock_identity_allowed_in_deployed_service": {
          "const": false
        }
      },
      "additionalProperties": false,
      "required": [
        "default_decision",
        "policy_release",
        "role_toolsets_manifest",
        "mock_identity_allowed_in_deployed_service"
      ]
    },
    "release": {
      "type": "object",
      "properties": {
        "source_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_working_tree_manifest": {
          "type": [
            "string",
            "null"
          ]
        },
        "image_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "bundles": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "capability_manifest": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "source_revision",
        "approved_working_tree_manifest",
        "image_digest",
        "bundles",
        "capability_manifest"
      ]
    },
    "data": {
      "type": "object",
      "properties": {
        "allowed_content": {
          "type": "array",
          "items": {
            "enum": [
              "admitted-public-metadata",
              "redistributable-projections",
              "synthetic-fixtures"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "private_original_archives": {
          "const": false
        },
        "bduk_secure_data": {
          "const": false
        },
        "bigquery": {
          "const": false
        },
        "licensed_feature_payloads": {
          "const": false
        },
        "external_model_calls": {
          "const": false
        },
        "live_provider_calls": {
          "const": false
        }
      },
      "additionalProperties": false,
      "required": [
        "allowed_content",
        "private_original_archives",
        "bduk_secure_data",
        "bigquery",
        "licensed_feature_payloads",
        "external_model_calls",
        "live_provider_calls"
      ]
    },
    "state": {
      "type": "object",
      "properties": {
        "bundle_store": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "mode": {
                  "const": "baked-image"
                },
                "backup_bucket_name": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false,
              "required": [
                "mode",
                "backup_bucket_name"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_store": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "backend": {
                  "const": "firestore"
                },
                "database_id": {
                  "type": "string",
                  "minLength": 1
                },
                "collection": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false,
              "required": [
                "backend",
                "database_id",
                "collection"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "retention_policy": {
          "type": [
            "string",
            "null"
          ]
        },
        "full_acceptance_requires_restart_proof": {
          "const": true
        },
        "store_nonce": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "software_revision": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "bundle_store",
        "evidence_store",
        "retention_policy",
        "full_acceptance_requires_restart_proof",
        "store_nonce",
        "created_at",
        "software_revision"
      ]
    },
    "operations": {
      "type": "object",
      "properties": {
        "name_prefix": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,19}$"
        },
        "runtime_sizing": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "cpu": {
                  "enum": [
                    "1",
                    "2"
                  ]
                },
                "memory": {
                  "enum": [
                    "512Mi",
                    "1Gi",
                    "2Gi"
                  ]
                },
                "min_instances": {
                  "const": 0
                },
                "max_instances": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3
                },
                "concurrency": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 40
                },
                "timeout_seconds": {
                  "type": "integer",
                  "minimum": 10,
                  "maximum": 300
                }
              },
              "additionalProperties": false,
              "required": [
                "cpu",
                "memory",
                "min_instances",
                "max_instances",
                "concurrency",
                "timeout_seconds"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "build_path": {
          "enum": [
            "local-oci",
            null
          ]
        },
        "logging_policy": {
          "type": [
            "string",
            "null"
          ]
        },
        "retention_on_destroy": {
          "enum": [
            "retain-evidence-and-backups",
            null
          ]
        },
        "preview_features_enabled": {
          "const": false
        },
        "image_repository": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name_prefix",
        "runtime_sizing",
        "build_path",
        "logging_policy",
        "retention_on_destroy",
        "preview_features_enabled",
        "image_repository"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "_status",
    "profile",
    "project",
    "authority",
    "network",
    "identity",
    "policy",
    "release",
    "data",
    "state",
    "operations"
  ]
}
