#!/bin/sh
set -eu

workbench_repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
cd "$workbench_repository_root"

pnpm --filter @gis-ai-go/mcp-gateway run prepare:test
pnpm --filter @gis-ai-go/mcp-gateway run build
pnpm --filter @gis-ai-go/public-data-workbench run build

exec node apps/mcp-gateway/dist/src/web216-workbench-main.js
