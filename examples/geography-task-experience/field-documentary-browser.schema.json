{
  "type": "object",
  "required": [
    "schema",
    "globalComplete",
    "basis",
    "counts",
    "statusCounts",
    "limits",
    "resources",
    "documents",
    "sections",
    "fields"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "gis-ai-go.field-documentary-browser.v1"
    },
    "globalComplete": {
      "const": false
    },
    "basis": {
      "type": "object",
      "required": [
        "candidateManifestSha256",
        "outputManifestSha256",
        "independentReviewSha256",
        "rootReviewSha256"
      ],
      "additionalProperties": false,
      "properties": {
        "candidateManifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "outputManifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "independentReviewSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rootReviewSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "collections",
        "documentAttributeSections",
        "explicitAttributeCodeListLinks",
        "nativeConstraintOccurrences",
        "nativeResources",
        "topLevelPropertyOccurrences"
      ],
      "additionalProperties": false,
      "properties": {
        "collections": {
          "type": "integer",
          "minimum": 0
        },
        "documentAttributeSections": {
          "type": "integer",
          "minimum": 0
        },
        "explicitAttributeCodeListLinks": {
          "type": "integer",
          "minimum": 0
        },
        "nativeConstraintOccurrences": {
          "type": "integer",
          "minimum": 0
        },
        "nativeResources": {
          "type": "integer",
          "minimum": 0
        },
        "topLevelPropertyOccurrences": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "statusCounts": {
      "type": "object",
      "required": [
        "explicit-attribute-link-and-exact-version-candidate",
        "matched-section-without-applicable-code-list-link",
        "no-exact-document-field-match",
        "version-unresolved-missing-native-components"
      ],
      "additionalProperties": false,
      "properties": {
        "explicit-attribute-link-and-exact-version-candidate": {
          "type": "integer",
          "minimum": 0
        },
        "matched-section-without-applicable-code-list-link": {
          "type": "integer",
          "minimum": 0
        },
        "no-exact-document-field-match": {
          "type": "integer",
          "minimum": 0
        },
        "version-unresolved-missing-native-components": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "limits": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 10000
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "id",
          "collectionId",
          "family",
          "kind",
          "url",
          "sha256",
          "bytes",
          "requestStartedAt",
          "requestFinishedAt",
          "versionContext",
          "nativeRootWithoutProperties",
          "propertiesKeyPresent",
          "propertiesType",
          "provenance"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200
          },
          "collectionId": {
            "type": "string",
            "maxLength": 160
          },
          "family": {
            "type": "string",
            "maxLength": 80
          },
          "kind": {
            "enum": [
              "schemas",
              "queryables"
            ]
          },
          "url": {
            "type": "string",
            "maxLength": 2048
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "requestStartedAt": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "requestFinishedAt": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "versionContext": {
            "type": "object",
            "required": [
              "basis",
              "schemaSourceId",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "basis": {
                "type": "string",
                "maxLength": 16384
              },
              "schemaSourceId": {
                "type": "string",
                "maxLength": 200
              },
              "value": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 80
              }
            }
          },
          "nativeRootWithoutProperties": {
            "type": "object"
          },
          "propertiesKeyPresent": {
            "const": true
          },
          "propertiesType": {
            "const": "dict"
          },
          "provenance": {
            "type": "object",
            "required": [
              "card",
              "bytes",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "card": {
                "type": "string",
                "maxLength": 200
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16384
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "id",
          "family",
          "url",
          "sha256",
          "bytes",
          "observedAt",
          "publicationDate",
          "codeListEdition",
          "provenance"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100
          },
          "family": {
            "type": "string",
            "maxLength": 80
          },
          "url": {
            "type": "string",
            "maxLength": 2048
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "observedAt": {
            "type": "string",
            "maxLength": 80
          },
          "publicationDate": {
            "type": "null"
          },
          "codeListEdition": {
            "type": "null"
          },
          "provenance": {
            "type": "object",
            "required": [
              "card",
              "bytes",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "card": {
                "type": "string",
                "maxLength": 200
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16384
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "required": [
          "id",
          "provenance",
          "native"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200
          },
          "provenance": {
            "type": "object",
            "required": [
              "card",
              "bytes",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "card": {
                "type": "string",
                "maxLength": 200
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16384
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "native": {
            "type": "object"
          }
        }
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": {
        "type": "object",
        "required": [
          "id",
          "provenance",
          "native"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200
          },
          "provenance": {
            "type": "object",
            "required": [
              "card",
              "bytes",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "card": {
                "type": "string",
                "maxLength": 200
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16384
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "native": {
            "type": "object"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gis-ai-go:private-field-documentary-browser:v1",
  "title": "Selected documentary field references",
  "description": "Closed projection wrappers. Native cards remain full source JSON. Cross-reference, native pointer, status-count and no-adoption checks are additionally required by the JavaScript validator; this schema alone does not establish source authenticity."
}
