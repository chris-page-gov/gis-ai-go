{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gis-ai-go:schema:classification-collections:v1",
  "title": "Closed local classification collection catalogue",
  "description": "A host-owned catalogue, not provider discovery or authority to fetch or publish payloads. Runtime admission additionally checks unique collection IDs, non-whitespace titles/scope notes and the UTF-8 byte bound.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "globalComplete", "collections"],
  "properties": {
    "schema": {"const": "gis-ai-go.classification-collections.v1"},
    "globalComplete": {"const": false},
    "collections": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "scopeNote", "schemeCount", "entryCount", "coverage"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 200},
          "scopeNote": {"type": "string", "minLength": 1, "maxLength": 2000},
          "schemeCount": {"type": "integer", "minimum": 1, "maximum": 64},
          "entryCount": {"type": "integer", "minimum": 0, "maximum": 1280000},
          "coverage": {"const": "selected-sources-only"}
        }
      }
    }
  }
}
