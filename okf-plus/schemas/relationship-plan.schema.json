            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "minItems": 0,
              "maxItems": 8
