              "source": {
                "type": "object",
                "properties": {
                  "identifier": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,36}$"
                  },
                  "identifierType": {
                    "enum": [
                      "GUID",
                      "TOID",
                      "UPRN",
                      "USRN"
                    ]
                  },
                  "featureType": {
                    "enum": [
                      "BLPU",
                      "ORRoadNode",
                      "ORRoadLink",
                      "Road",
                      "RoadLink",
                      "Street",
                      "TopographicArea"
                    ]
                  }
                },
                "required": [
                  "identifier",
                  "identifierType",
                  "featureType"
                ],
                "additionalProperties": false
              },
