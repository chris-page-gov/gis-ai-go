      "required": [
        "schema",
        "inputSha256",
        "strategy",
        "candidates",
        "unresolved",
        "automaticExecution",
        "joinsEstablished",
        "transitiveIdentity",
        "fieldEquivalence",
        "geographicEquivalence",
        "spatialFallback",
        "limits",
        "sourceConstraints"
