                "additionalProperties": false
              },
              "relationship": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "sourceEvidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "reference": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
