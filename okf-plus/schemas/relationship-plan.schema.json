          "additionalProperties": false
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "maxItems": 8
        },
        "sourceConstraints": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidateId",
              "method",
              "meaning",
              "limits",
              "sourceEvidence"
