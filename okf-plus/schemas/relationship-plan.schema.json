                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "reference",
                    "sha256"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 8
              },
              "scopeStatus": {
                "enum": [
                  "supported",
                  "unresolved",
                  "incompatible"
                ]
              },
              "versionStatus": {
                "enum": [
                  "supported",
                  "unresolved",
                  "incompatible"
                ]
              },
              "observationStatus": {
                "enum": [
                  "not-observed",
                  "observed",
                  "empty-response",
                  "denied",
                  "incomplete"
                ]
              },
              "method": {
                "enum": [
                  "BLPU_UPRN_RoadLink_TOID_9",
                  "BLPU_UPRN_Street_USRN_11",
                  "BLPU_UPRN_TopographicArea_TOID_5",
                  "ORRoadLink_GUID_RoadLink_TOID_12",
                  "ORRoadNode_GUID_RoadLink_TOID_13",
                  "RoadLink_TOID_Road_TOID_7",
                  "RoadLink_TOID_Street_USRN_8",
                  "RoadLink_TOID_TopographicArea_TOID_2",
                  "Road_TOID_Street_USRN_10",
                  "Road_TOID_TopographicArea_TOID_3",
                  "Street_USRN_TopographicArea_TOID_4"
                ]
              },
              "estimatedRequests": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20
              },
              "targetSemantics": {
                "enum": [
                  "source-declared",
                  "building-outline",
                  "road-surface"
                ]
              }
            },
            "required": [
              "id",
              "kind",
              "source",
              "targetType",
              "relationship",
              "sourceEvidence",
              "scopeStatus",
              "versionStatus",
              "observationStatus"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 32
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "minItems": 0,
                "maxItems": 8
              }
            },
            "required": [
              "id",
              "reasons"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 32
