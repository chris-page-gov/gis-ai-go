                "type": "object",
                "properties": {
                  "identifierType": {
                    "enum": [
                      "GUID",
                      "TOID",
                      "UPRN",
                      "USRN"
                    ]
                  },
                  "featureType": {
                    "enum": [
                      "BLPU",
                      "ORRoadNode",
                      "ORRoadLink",
                      "Road",
                      "RoadLink",
                      "Street",
                      "TopographicArea"
                    ]
                  }
                },
                "required": [
                  "identifierType",
                  "featureType"
