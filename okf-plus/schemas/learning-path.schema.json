{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chris-page-gov.github.io/gis-ai-go/okf-plus/schemas/learning-path.schema.json",
  "title": "Optional OKF+ authored learning-path metadata",
  "type": "object",
  "required": ["schema", "id", "title", "description", "objectives", "prerequisites", "prerequisiteConcepts", "steps", "relationshipScope"],
  "properties": {
    "schema": {"const": "gis-ai-go.okf-plus-learning-path.v1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 240},
    "description": {"type": "string", "minLength": 1, "maxLength": 800},
    "objectives": {"type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 400}},
    "prerequisites": {"type": "array", "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$"}},
    "prerequisiteConcepts": {
      "type": "array", "maxItems": 12,
      "items": {
        "type": "object", "required": ["recordId", "purpose"],
        "properties": {"recordId": {"$ref": "#/$defs/recordId"}, "purpose": {"type": "string", "minLength": 1, "maxLength": 400}},
        "additionalProperties": false
      }
    },
    "steps": {
      "type": "array", "minItems": 1, "maxItems": 24,
      "items": {
        "type": "object", "required": ["recordId", "title", "outcome", "practice", "minutes", "conceptRefs", "sourceRefs"],
        "properties": {
          "recordId": {"$ref": "#/$defs/recordId"},
          "title": {"type": "string", "minLength": 1, "maxLength": 240},
          "outcome": {"type": "string", "minLength": 1, "maxLength": 800},
          "practice": {"type": "string", "minLength": 1, "maxLength": 1200},
          "minutes": {"type": "integer", "minimum": 1, "maximum": 480},
          "conceptRefs": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"$ref": "#/$defs/recordId"}},
          "sourceRefs": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 2048}}
        },
        "additionalProperties": false
      }
    },
    "relationshipScope": {"const": "learning-navigation-only"}
  },
  "$defs": {
    "recordId": {"type": "string", "pattern": "^https://chris-page-gov\\.github\\.io/gis-ai-go/okf-plus/id/[^\\s]+$", "maxLength": 2048}
  },
  "additionalProperties": false
}
