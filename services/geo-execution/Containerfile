FROM python:3.12.14-slim-bookworm@sha256:a116514e19457bcb7af7efe9c3dd0b9b71e85b317694e7882a1c52aa15a78134

LABEL org.opencontainers.image.title="GIS AI GO private execution service" \
      org.opencontainers.image.description="Synthetic-only deterministic execution boundary" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.source="https://github.com/chris-page-gov/gis-ai-go"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/services/geo-execution/src

