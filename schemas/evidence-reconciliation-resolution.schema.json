{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gis-ai-go:schema:evidence-reconciliation-resolution:v1",
  "title": "GIS AI GO evidence reconciliation resolution",
  "description": "An immutable receipt-only resolution published before the linked ledger receipt.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "resolution_id", "index_id", "ledger_id", "resolved_at", "retain_until", "claim_id", "idempotency_key_sha256", "request_fingerprint_sha256", "receipt_id"],
  "properties": {
    "schema": { "const": "gis-ai-go.evidence-reconciliation-resolution.v1" },
    "resolution_id": {
      "type": "string",
      "pattern": "^gis-ai-go:evidence-reconciliation-resolution:sha256:[0-9a-f]{64}$"
    },
    "index_id": {
      "type": "string",
      "pattern": "^gis-ai-go:evidence-reconciliation-index:sha256:[0-9a-f]{64}$"
    },
    "ledger_id": {
      "type": "string",
      "pattern": "^gis-ai-go:public-evidence-ledger:sha256:[0-9a-f]{64}$"
    },
    "resolved_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "retain_until": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "claim_id": {
      "type": "string",
      "pattern": "^gis-ai-go:evidence-reconciliation-claim:sha256:[0-9a-f]{64}$"
    },
    "idempotency_key_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "request_fingerprint_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "receipt_id": {
      "type": "string",
      "pattern": "^gis-ai-go:evidence-receipt:sha256:[0-9a-f]{64}$"
    }
  }
}
