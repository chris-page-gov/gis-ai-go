{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gis-ai-go:schema:execution-request:1",
  "title": "GIS AI GO private execution request",
  "description": "Closed gateway-to-execution envelope. It is not an end-user authentication or policy contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "operation",
    "trace",
    "gateway_authorisation",
    "deadline",
    "limits",
    "parameters"
  ],
  "properties": {
    "schema": {
      "const": "gis-ai-go.execution-request.v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "operation": {
      "const": "fixture.features.query"
    },
    "trace": {
      "$ref": "#/$defs/trace"
    },
    "gateway_authorisation": {
      "$ref": "#/$defs/gatewayAuthorisation"
    },
    "deadline": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "parameters": {
      "$ref": "#/$defs/parameters"
    }
  },
  "$defs": {
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traceparent"],
      "properties": {
        "traceparent": {
          "type": "string",
          "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-(?:00|01)$"
        },
        "tracestate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[\\x20-\\x7E]+$"
        }
      }
    },
    "gatewayAuthorisation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "decision_id",
        "decision_digest",
        "permitted_operation"
      ],
      "properties": {
        "schema": {
          "const": "gis-ai-go.gateway-authorisation.v1"
        },
        "decision_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
        },
        "decision_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "permitted_operation": {
          "const": "fixture.features.query"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_features",
        "max_coordinates",
        "max_input_bytes",
        "max_output_bytes",
        "max_complexity"
      ],
      "properties": {
        "max_features": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_coordinates": {
          "type": "integer",
          "minimum": 4,
          "maximum": 128
        },
        "max_input_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65536
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 262144
        },
        "max_complexity": {
          "type": "integer",
          "minimum": 16,
          "maximum": 20000
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "dataset_id",
        "version",
        "rights",
        "source_uri"
      ],
      "properties": {
        "provider_id": {
          "const": "gis-ai-go.synthetic-fixture"
        },
        "dataset_id": {
          "const": "synthetic-gb-places"
        },
        "version": {
          "const": "1.0.0"
        },
        "rights": {
          "const": "CC0-1.0"
        },
        "source_uri": {
          "const": "urn:gis-ai-go:fixture:synthetic-gb-places:1"
        }
      }
    },
    "position": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "polygon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": {
          "const": "Polygon"
        },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "array",
            "minItems": 4,
            "maxItems": 128,
            "items": {
              "$ref": "#/$defs/position"
            }
          }
        }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id",
        "source",
        "crs",
        "axis_order",
        "geometry",
        "limit"
      ],
      "properties": {
        "fixture_id": {
          "const": "synthetic-gb-places-v1"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "crs": {
          "const": "EPSG:4326"
        },
        "axis_order": {
          "const": "longitude-latitude"
        },
        "geometry": {
          "$ref": "#/$defs/polygon"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    }
  }
}
