{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gis-ai-go:schema:local-edition-acceptance:v1",
  "title": "Exact-artifact local evaluation acceptance, not public-service acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "edition", "source_commit", "source_tree", "artefacts", "checks"],
  "properties": {
    "schema": {"const": "gis-ai-go.local-edition-acceptance.v1"},
    "edition": {"const": "0.2.0-local.1"},
    "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "source_tree": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "artefacts": {
      "type": "object",
      "required": ["gis-ai-go-v0.2.0-local.1-source.tar.gz", "local214-package-manifest.json", "SHA256SUMS", "gis-ai-go-local214-walkthrough.pdf", "guide-manifest.json"],
      "propertyNames": {"pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"},
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "checks": {
      "type": "array", "minItems": 11, "maxItems": 11,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status", "evidence", "scope"],
        "properties": {
          "id": {"enum": ["local-process-acceptance", "independent-five-tool-client", "expiry-boundaries", "source-archive-integrity", "macos-clean-source-journey", "linux-clean-source-journey", "dependency-disposition", "a4-print-review", "independent-instruction-only-review", "unaided-colleague-walkthrough", "canonical-protected-main-assurance"]},
          "status": {"enum": ["passed", "failed", "pending", "unavailable"]},
          "evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
          "scope": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "allOf": [{"if": {"properties": {"status": {"const": "passed"}}}, "then": {"properties": {"evidence": {"minItems": 1}}}}]
      }
    }
  }
}
