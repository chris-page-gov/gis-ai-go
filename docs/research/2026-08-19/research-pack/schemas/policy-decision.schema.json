{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/locus-accord/schemas/policy-decision.schema.json",
  "title": "Policy Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "decided_at",
    "policy_version",
    "authority_context_id",
    "effect",
    "reasons",
    "obligations",
    "pip_evidence",
    "expires_at",
    "trace_id"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "pattern": "^pdp_[A-Za-z0-9_-]+$"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_version": {
      "type": "string"
    },
    "authority_context_id": {
      "type": "string"
    },
    "effect": {
      "enum": [
        "allow",
        "deny",
        "allow-with-obligations"
      ]
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "policy_rule": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "parameters"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "parameters": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "pip_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "observed_at",
          "digest"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "digest": {
            "type": "string"
          },
          "attributes": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "permit_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    }
  }
}
