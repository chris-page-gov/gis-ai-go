{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/locus-accord/schemas/workflow-profile.schema.json",
  "title": "Workflow Profile",
  "type": "object",
  "required": [
    "id",
    "name",
    "purpose",
    "definition_authority",
    "steps",
    "human_approval",
    "task_usage",
    "mrtr_usage",
    "tiers",
    "entry_criteria",
    "exit_criteria",
    "rollback",
    "source_ids"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "definition_authority": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_approval": {
      "type": "string"
    },
    "task_usage": {
      "type": "string"
    },
    "mrtr_usage": {
      "type": "string"
    },
    "tiers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entry_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exit_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollback": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
